# ============================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - FULLSTACK
# ============================================
# Copia este archivo a .env y ajusta los valores según tus necesidades
# Uso: docker-compose up -d

# ============================================
# CONFIGURACIÓN DEL BACKEND
# ============================================
# Puerto del servidor backend (por defecto: 8080)
SERVER_PORT=9086

# Host de la aplicación (sin puerto)
# Para desarrollo local: http://localhost
# Para Codespaces: https://tu-usuario-nombre-repo-xxxx.preview.app.github.dev
APP_HOST=http://localhost

# Nombre de la aplicación Spring Boot
SPRING_APPLICATION_NAME=projectPruebasApis

# ============================================
# CONFIGURACIÓN DEL FRONTEND
# ============================================
# Puerto del frontend (nginx sobre contenedor)
FRONTEND_PORT=3000

# Imagen del frontend (opcional, si usas Docker Hub)
FRONTEND_IMAGE=luisvalle1/frontend-movies-jobs:latest

# Nombre de la aplicación frontend
APP_NAME=movies-jobs-frontend

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (R2DBC)
# ============================================
# URL de conexión a PostgreSQL con R2DBC (Neon)
SPRING_R2DBC_URL=r2dbc:postgresql://tu-host.neon.tech:5432/tu-database

# Usuario de la base de datos
SPRING_R2DBC_USERNAME=tu_usuario

# Contraseña de la base de datos
SPRING_R2DBC_PASSWORD=tu_password

# Modo SSL para la conexión (require, prefer, disable)
SPRING_R2DBC_PROPERTIES_SSLMODE=require

# ============================================
# CONFIGURACIÓN DE RAPIDAPI
# ============================================
# API Key principal de RapidAPI
RAPIDAPI_KEY=tu_rapidapi_key

# Host de la API de películas
RAPIDAPI_MOVIE_HOST=ai-movie-recommender.p.rapidapi.com

# Host de la API de búsqueda de trabajos (JSearch)
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# Host de la API de YouTube
RAPIDAPI_YOUTUBE_HOST=youtube-media-downloader.p.rapidapi.com

# ============================================
# CONFIGURACIÓN DE SPRINGDOC (SWAGGER)
# ============================================
# Ruta de la documentación OpenAPI
SPRINGDOC_API_DOCS_PATH=/v3/api-docs

# Ruta de Swagger UI
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

# Habilitar/deshabilitar Swagger UI (true/false)
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ============================================
# CONFIGURACIÓN DE LOGGING
# ============================================
# Nivel de log para SpringDoc (TRACE, DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_SPRINGDOC=DEBUG

# Nivel de log para Spring Web
LOGGING_LEVEL_SPRING_WEB=DEBUG

# Nivel de log general de la aplicación
LOGGING_LEVEL_ROOT=INFO

# ============================================
# CONFIGURACIÓN DE JAVA/JVM
# ============================================
# Opciones adicionales de JVM (memoria, GC, etc)
JAVA_OPTS=-Xmx512m -Xms256m

# Zona horaria de la aplicación
TZ=America/Lima

# ============================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================
# 
# DESARROLLO LOCAL:
# SERVER_PORT=9086
# FRONTEND_PORT=3000
# APP_HOST=http://localhost
# URLs: 
#   - Frontend: http://localhost:3000
#   - Backend: http://localhost:9086
# 
# CODESPACES (ejemplo):
# SERVER_PORT=9086
# FRONTEND_PORT=3000
# APP_HOST=https://tu-usuario-repo-xxxx.preview.app.github.dev
# URLs (Codespaces auto-forward):
#   - Frontend: Puerto 3000 forwarded
#   - Backend: Puerto 9086 forwarded
# 
# TESTING EN PUERTO ALTERNATIVO:
# SERVER_PORT=8080
# FRONTEND_PORT=4000
# APP_HOST=http://localhost
# 
# PRODUCCIÓN:
# SERVER_PORT=80
# FRONTEND_PORT=80
# APP_HOST=https://tu-dominio.com
